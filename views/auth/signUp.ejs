<main class="d-flex w-100">
 <div class="container d-flex flex-column">
  <div class="row vh-100">
   <div class="col-sm-10 col-md-8 col-lg-6 mx-auto d-table h-100">
    <div class="d-table-cell align-middle wow animate__fadeIn">
     <div class="text-center mt-4">
      <h1 class="h2">Vamos começar!</h1>
      <p class="lead">
       Precisamos somente de algumas informações.
      </p>
     </div>
     <div class="card">
      <div class="card-body">
       <div class="m-sm-4">
        <div class="form-group">
         <label>Nome</label>
         <input class="form-control" type="text" name="name" placeholder="Insira seu nome" />
        </div>
        <div class="form-group">
         <label>Email</label>
         <input class="form-control" type="email" name="email" placeholder="Insira se email" />
        </div>
        <div class="form-group">
         <label>Senha</label>
         <input class="form-control" type="password" name="password" placeholder="Insira sua senha" />
        </div>
        <div class="form-group">
         <label>Qual é objetivo com uso dessa plataforma?</label>
         <select class="form-control">
          <option selected="">Selecione</option>
          <option>Realizar pesquisas</option>
          <option>Consulta de dados</option>
          <option>Integração com outro sistema</option>
          <option>Nenhuma opção</option>
         </select>
        </div>
        <div class="text-center mt-3">
         <button onclick="page.signUp()" class="btn btn-lg btn-primary">Cadastrar</button>
        </div>
        <div class="text-center mt-3">
         <a href="/auth/#/entrar"> Voltar para pagina anterior</a>
        </div>
       </div>
      </div>
     </div>
    </div>
   </div>
  </div>
 </div>
</main>
<%- include("script/signUp") %>