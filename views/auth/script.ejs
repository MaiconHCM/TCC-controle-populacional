<script>
  new WOW().init();
  app = {};
  loading = '<style>*,body,html{padding:0;margin:0;box-sizing:border-box;font-family:Poppins,sans-serif;perspective:800px}::selection{background-color:#2d98da;color:#fff}body{background-color:#fff;display:flex;justify-content:center;align-items:center;width:100%;min-height:100vh}.Box{position:relative;width:123px;height:123px;background-color:#204065;border:5px solid #204095;box-shadow:0 0 10px rgba(0,0,0,.2);transform-style:preserve-3d;transform-origin:center;transform:rotate(45deg);display:flex;flex-wrap:wrap;box-sizing:content-box}.Box span{width:40px;height:40px;background:#fff;box-sizing:content-box;margin:.5px;transform-style:preserve-3d;transform-origin:center;animation:Loader 2s linear infinite}.Box span:nth-child(3){animation-delay:.8s}.Box span:nth-child(2),.Box span:nth-child(6){animation-delay:.6s}.Box span:last-child,.Box span:nth-child(1),.Box span:nth-child(5){animation-delay:.4s}.Box span:nth-child(4),.Box span:nth-child(8){animation-delay:.2s}.Box span:nth-child(7){animation-delay:0s}@keyframes Loader{0%,100%{transform:scale(1)}30%{transform:scale(0)}50%{transform:scale(0)}75%{transform:scale(1)}}</style>'
  loading += '<div class="Box"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>'

  //Efetua o cadastro.
  app.signUp = function () {
    let name = $('input[name=name]').val();
    let password = $('input[name=password]').val();
    let email = $('input[name=email]').val();

    $.post("/users/register", { name, password, email }, function (data) {
      if (data.status === 'success') {
        $.post("/users/authenticate", { email, password }, function (data) {
          if (data.status === 'success') {
            window.localStorage.setItem('x-access-token', data.data.token);
            window.location.href = '/app/#/inicio';
          } else {
            alert('error');
          }
        });
      } else {
        alert('error');
      }
    });
  }

  //Efetua login
  app.signIn = function () {
    let email = $('input[name=email]').val();
    let password = $('input[name=password]').val();

    $.post("/users/authenticate", { email, password }, function (data) {
      if (data.status === 'success') {
        window.localStorage.setItem('x-access-token', data.data.token);
        window.location.href = '/app/#/inicio';
      } else {
        alert('error');
      }
    });
  }

  //Efetua a saida da sessão
  app.signOut = function () {
    window.localStorage.removeItem('x-access-token');
  }

  //salva pagina para evitar gasto de dados
  app.cache = {};
  app.setCache = function (url, html) {
    app.cache[url] = html;
  }
  app.getCache = function (url) {
    if (app.cache[url]) {
      return app.cache[url];
    } else {
      return false;
    }
  }

  // Carrega nova pagina baseado no hash(#) da url
  app.load = function () {
    let page = this.getHashUrl();
    let cacheHTML = app.getCache(page);
    if (cacheHTML) {
      $('body').html(cacheHTML);
    } else {
      $('body').html(loading);
      let token = window.localStorage.getItem('x-access-token');
      if (token) {
        $.ajaxSetup({headers: {'x-access-token': token}});
      }else if($.ajaxSettings.headers){
        delete $.ajaxSettings.headers["x-access-token"];
      }
      $.get("/auth/" + page, function (data) {
        app.setCache(page, data);
        $('body').html(data);
      }).fail(function (data) {
        switch (data.status) {
          case 404: window.location.href = '/auth/#/404'; break;
          case 403: window.location.href = '/app/#/inicio'; break;
        }
      });
    }
  }

  //Obtem o hash e também corrige (se necessario);
  app.getHashUrl = function () {
    if (window.location.hash === '' || (window.location.hash).search("/") === -1 || window.location.hash === '#/') {
      window.location.href = '/auth/#/entrar';
    }
    let page = window.location.hash;
    return page.replace('#/', '');
  }

  app.isUrl = function () {
    switch (app.getHashUrl()) {
      case 'sair':
        app.signOut();
        break;
    }
  }

  //Ao iniciar
  $(document).ready(function () {
    window.onhashchange = function () {
      app.load();
    }
    app.load();
    app.isUrl();
  });
</script>