<script>
 new WOW().init();
loading=
'<main class="d-flex w-100">'+
' <div class="container d-flex flex-column">'+
'  <div class="row vh-100">'+
'   <div class="col-sm-10 col-md-8 col-lg-6 mx-auto d-table h-100">'+
'    <div class="d-table-cell align-middle wow animate__fadeIn">'+
'     <div class="card">'+
'      <div class="card-body">'+
'       <div class="m-sm-4" style="display:flex;justify-content: center;">'+
'       <div class="loader wow animate__fadeIn"><div class="loader-wheel"></div><div class="loader-text"></div></div>'+
'       </div>'+
'      </div>'+
'     </div>'+
'    </div>'+
'   </div>'+
'  </div>'+
' </div>'+
'</main>';
	
 
 app = {};
 //salva pagina para evitar gasto de dados
 app.cache = {};
 app.setCache = function (url, html) {
  app.cache[url] = html;
 }
 app.getCache = function (url) {
  if (app.cache[url]) {
   return app.cache[url];
  } else {
   return false;
  }
 }

 // Carrega nova pagina baseado no hash(#) da url
 app.load = function () {
  page = {};
  let hash = this.getHashUrl();
  let cacheHTML = app.getCache(hash);
  if (cacheHTML) {
   $('body').html(cacheHTML);
  } else {
   $('body').html(loading);

   //Obtem token do local storage
   let token = window.localStorage.getItem('x-access-token');

   if (token) {
    //caso token existir coloca configuração
    $.ajaxSetup({ headers: { 'x-access-token': token } });
   } else if ($.ajaxSettings.headers) {
    //caso não exista, ele é apagado
    delete $.ajaxSettings.headers["x-access-token"];
   }

   //faz requisição
   $.get("/auth/" + hash, function (data) {
    app.setCache(hash, data);
    $('body').html(data);
   }).fail(function (data) {
    switch (data.status) {
     case 404: window.location.href = '/auth/#/404'; break;
     case 403: window.location.href = '/app/#/inicio'; break;
    }
   });
  }
 }

 //Obtem o hash e também corrige (se necessario);
 app.getHashUrl = function () {
  if (window.location.hash === '' || (window.location.hash).search("/") === -1 || window.location.hash === '#/') {
   window.location.href = '/auth/#/entrar';
  }
  let hash = window.location.hash;
  return hash.replace('#/', '');
 }
 //Toda vez que link mudar, vai ser verificado por essa função.
 window.onhashchange = function () {
  app.load();
 }

 //Ao iniciar
 $(document).ready(function () {
  app.load();
 });
</script>