<script>
  page = new List("/api/procedures-performed/");
  page.list = function (data) {
    let a = '';
    for (const prop in data) {
      const item = data[prop]
      const animal = app.variables.animals.find(x => x._id === data[prop].animal)
      let startAt = new Date(item.startAt)
      startAt = app.pad(startAt.getDate(), 2) + '/' + app.pad(startAt.getMonth() + 1, 2) + '/' + startAt.getFullYear()
      let endAt;
      if (item.endAt) {
        endAt = new Date(item.endAt)
        endAt = app.pad(endAt.getDate(), 2) + '/' + app.pad(endAt.getMonth() + 1, 2) + '/' + endAt.getFullYear()
      } else
        endAt = "Ativo"




      let btnView =
        '<a href="/app/#/procedimentos-realizados/view?id=' + item._id + '" class="btn btn-info btn-link btn-sm">' +
        '<i class="fas fa-eye"></i> Visualizar' +
        '</a>'
      let btnDelete = ""
      let btnEdit = ""
      if (window.localStorage.getItem('role') == 0 || window.localStorage.getItem('role') == 1) {
        btnEdit =
          '<a href="/app/#/procedimentos-realizados/form?id=' + item._id + '" class="btn btn-primary btn-link btn-sm">' +
          '<i class="fas fa-pencil-alt"></i> Editar' +
          '</a>'
        btnDelete =
          '<button onclick="page.delete(\'' + item._id + '\')" type="button" rel="tooltip" class="btn btn-danger btn-link btn-sm">' +
          '<i class="fas fa-trash"></i> Apagar' +
          '</button>'
      }



      a +=
        '<tr>' +
        '<td>' + animal.name + '</td>' +
        '<td>' + startAt + '</td>' +
        '<td>' + endAt + '</td>' +
        '<td colspan="2" class="text-right">' +
        btnView + btnEdit + btnDelete +
        '</td>' +
        '</tr>';
    }
    if (a === '') {
      a = "<tr><td>Não possuí nenhum registro.</td></tr>"
    }
    $('#data-view').html(a);
  }
  page.filter();
</script>