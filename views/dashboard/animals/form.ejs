<div class="panel-header panel-header-sm">
</div>
<div class="content wow wow animate__fadeIn">
 <div class="row">
  <div class="col-md-12">
   <div class="card">
    <div class="card-header">
     <h5 class="title">Novo animal</h5>
    </div>
    <div class="card-body">
     <form>
      <div class="row">
       <div class="col-md-5 pr-1">
        <div class="form-group">
         <label>Raça</label>
         <input type="text" class="form-control" placeholder="Raça do animal recolhido">
        </div>
       </div>
       <div class="col-md-3 px-1">
        <div class="form-group">
         <label>Sexo</label>
         <select class="form-control">
          <option selected="">Selecione</option>
          <option>Macho</option>
          <option>Fêmea</option>
         </select>
        </div>
       </div>
       <div class="col-md-4 pl-1">
        <div class="form-group">
         <label for="exampleInputEmail1">Código do chip</label>
         <input type="email" class="form-control" placeholder="Código">
        </div>
       </div>
      </div>
      <div class="row">
       <div class="col-md-6 pr-1">
        <div class="form-group">
         <label>Qual situação do animal?</label>
         <select class="form-control">
          <option selected="">Selecione</option>
          <option>Maus-tratos</option>
          <option>Abandono</option>
          <option>Apresenta risco</option>
          <option>Nenhuma opção</option>
         </select>
        </div>
       </div>
       <div class="col-md-2 pl-1">
        <div class="form-check">
         <label class="form-check-label">
          <input class="form-check-input" type="checkbox">
          <span class="form-check-sign"></span>
          Animal Castrado
         </label>
        </div>
       </div>
       <div class="col-md-2 pl-1">
        <div class="form-check">
         <label class="form-check-label">
          <input class="form-check-input" type="checkbox">
          <span class="form-check-sign"></span>
          Possui zoonense
         </label>
        </div>
       </div>
       <div class="col-md-2 pl-1">
        <div class="form-check">
         <label class="form-check-label">
          <input class="form-check-input" type="checkbox">
          <span class="form-check-sign"></span>
          Situação de risco
         </label>
        </div>
       </div>
      </div>
      <div class="row">
       <div class="col-md-4">
        <div class="form-group">
         <label>Bairro</label>
         <input type="text" class="form-control" placeholder="Bairro onde esse animal foi recolhido" value="">
        </div>
       </div>
       <div class="col-md-8">
        <div class="form-group">
         <label>Endereço de recolhimento</label>
         <input type="text" class="form-control" placeholder="Endereço onde esse animal foi recolhido" value="">
        </div>
       </div>
      </div>
      <div class="row">
       <div class="col-md-12">
        <div class="form-group">
         <label>Observação</label>
         <textarea rows="4" cols="80" class="form-control"
          placeholder="Observação, detalhes, informações adicionais, etc..."></textarea>
        </div>
       </div>
      </div>
     </form>
    </div>
   </div>
  </div>
 </div>
</div>
<%- include("script/form") %>