<div class="panel-header panel-header-sm">
</div>
<div class="content wow wow animate__fadeIn">
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <h5 class="title">Informações da Pessoa</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6 pr-1">
              <div class="form-group">
                <label>Nome completo</label>
                <input name="name" type="text" class="form-control" placeholder="Insira o nome completo">
              </div>
            </div>
            <div class="col-md-3 pr-1">
              <div class="form-group">
                <label>Sexo</label>
                <select name="sex" class="form-control">
                  <option value="" selected="">Selecione...</option>
                  <option value="0">Feminino</option>
                  <option value="1">Masculino</option>
                  <option value="2">Não declarado</option>
                </select>
              </div>
            </div>
            <div class="col-md-3 pr-1">
              <div class="form-group">
                <label>Data de nascimento</label>
                <input name="dateBirth" type="date" class="form-control">
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 pr-1">
              <div class="form-group">
                <label>Email</label>
                <input name="email" type="email" class="form-control" placeholder="Insira um email de contato" value="">
              </div>
            </div>
            <div class="col-md-3 pr-1">
              <div class="form-group">
                <label>Telefone</label>
                <input name="telephone" type="tel" class="form-control" placeholder="Insira telefone de contato"
                  value="">
              </div>
            </div>
            <div class="col-md-3 pr-1">
              <div class="form-group">
                <label>Celular</label>
                <input name="cellphone" type="tel" class="form-control" placeholder="Insira celular de contato"
                  value="">
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-3 pr-1">
              <div class="form-group">
                <label>CEP</label>
                <input name="cep" type="email" class="form-control" placeholder="Insira CEP da residência" value="">
              </div>
            </div>
            <div class="col-md-3 pr-1">
              <div class="form-group">
                <label>Bairro</label>
                <input name="neighborhood" type="text" class="form-control" placeholder="Insira o bairro da residência"
                  value="">
              </div>
            </div>
            <div class="col-md-3 pr-1">
              <div class="form-group">
                <label>Logradouro</label>
                <input name="address" type="text" class="form-control" placeholder="Insira o logradouro da residência"
                  value="">
              </div>
            </div>
            <div class="col-md-3 pr-1">
              <div class="form-group">
                <label>Número</label>
                <input name="number" type="number" class="form-control" placeholder="Insira o número da residência"
                  value="">
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-4 pr-1">
              <div class="form-group">
                <label>Cidade</label>
                <input name="city" type="email" class="form-control" placeholder="Insira cidade" value="">
              </div>
            </div>
            <div class="col-md-4 pr-1">
              <div class="form-group">
                <label>Estado</label>
                <input name="state" type="text" class="form-control" placeholder="Insira o estado" value="">
              </div>
            </div>
            <div class="col-md-4 pr-1">
              <div class="form-group">
                <label>Complemento</label>
                <input name="complement" type="text" class="form-control" placeholder="Insira o complemento" value="">
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-4 pr-1">
              <div class="form-group">
                <label>CPF:</label>
                <input name="cpf" type="email" class="form-control" placeholder="Insira o CPF da pessoa" value="">
              </div>
            </div>
            <div class="col-md-4 pr-1">
              <div class="form-group">
                <label>RG:</label>
                <input name="rg" type="text" class="form-control" placeholder="Insira o RG da pessoa" value="">
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-12 pr-1 text-center">
              <a href="/app/#/pessoas/" class="btn btn-lg btn-secondary"><i class="fas fa-arrow-left"></i>
                Voltar</a>
              <button class="btn btn-lg btn-primary" onclick="page.save()"><i class="fa fa-plus"></i>
                Salvar</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <%- include("script/form") %>