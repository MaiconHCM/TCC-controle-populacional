<script>
 page = new Form("/api/clinics/");
 page.fields = {
  name: { input: $('input[name=name]'), required: true },
  sex: { input: $('select[name=sex]') },
  email: { input: $('input[name=email]'), required: true },
  telephone: { input: $('input[name=telephone]') },
  cellPhone: { input: $('input[name=cellphone]'), required: true },
  cep: { input: $('input[name=cep]') },
  neighborhood: { input: $('input[name=neighborhood]') },
  address: { input: $('input[name=address]') },
  number: { input: $('input[name=number]') },
  complement: { input: $('input[name=complement]') },
  city: { input: $('input[name=city]') },
  state: { input: $('input[name=state]') },
  cnpj: { input: $('input[name=cnpj]') },
  crmv: { input: $('input[name=crmv]') },
  medicResponsible: { input: $('input[name=medicResponsible]') }
 };
 //load page event
 page.load = function () {
  let id = app.getUrlParameter('id');
  if (app.getUrlParameter('id')) {
   $.get(page.requestURL + id, function (response) {
    if (response.status === 'success') {
     page.loadFieldsValues(response.data);
     page.mask();
    } else {
     Swal.fire(
      'Ocorreu algum problema!',
      response.message,
      'warning'
     )
    }
   }).fail(function () {
    Swal.fire(
     'Ocorreu algum erro!',
     'Não foi possivel obter esse registro.',
     'error'
    )
   });
  }else{
   page.mask();
  }
 }
 page.mask = function () {
  $('input[name=crmv]').mask('00000');
  $('input[name=cnpj]').mask('00.000.000/0000-00', {reverse: true});
  $('input[name=cep]').mask('00000-000');
  $('input[name=telephone]').mask('(00) 0000-0000');
  $('input[name=cellphone]').mask('(00) 0000-00000');
 }
 page.load();
</script>