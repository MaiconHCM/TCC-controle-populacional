<div class="panel-header panel-header-sm">
</div>
<div class="content wow animate__fadeInUp">
 <div class="row">
  <div class="col-md-12">
   <div class="card  card-tasks">
    <div class="card-header">
     <a href="/app/#/clinicas/form" type="submit" class="btn btn-primary pull-right"><i class="fa fa-plus"></i>
      Novo</a>
     <h5 class="card-category">Clínicas</h5>
     <h4 class="card-title">Lista</h4>
    </div>
    <div class="card-body ">
     <div class="table-full-width table-responsive">
      <table class="table table-hover">
       <div class="input-group no-border">
        <input name="search" onkeyup="page.filter()" type="text" value="" class="form-control" placeholder="Pesquisar...">
        <div class="input-group-append">
         <div class="input-group-text">
          <i class="now-ui-icons ui-1_zoom-bold"></i>
         </div>
        </div>
       </div>
       <thead>
        <tr>
         <th>Nome</th>
         <th colspan="2"></th>
        </tr>
       </thead>
       <tbody id="data-view">
       </tbody>
      </table>
     </div>
    </div>
    <div class="card-footer ">
     <hr>
     <div id="data-status" class="stats">
     </div>
    </div>
   </div>
  </div>
 </div>
</div>
<%- include("script/index") %>